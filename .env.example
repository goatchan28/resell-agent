# Copy to .env and fill in from https://developer.ebay.com/my/keys
# .env is gitignored. These are secrets.

# "sandbox" or "production". Everything below must match this environment:
# sandbox and production have separate keysets AND separate RuNames.
EBAY_ENV=sandbox

# From Application Keys page. Sandbox keyset, not production.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# The RuName (a.k.a. "eBay Redirect URL name"), NOT a URL.
# Looks like: Your_Name-YourNam-SomeAp-abcdefgh
# Found under Application Keys -> User Tokens -> "Get a Token from eBay via Your Application".
EBAY_RUNAME=

# Optional. Space-separated. Defaults to the V1 set in config.py.
# Scope strings always use the api.ebay.com host, even for sandbox.
# EBAY_SCOPES=

EBAY_MARKETPLACE_ID=EBAY_US

# SQLite file. Holds tokens and the append-only event log.
RESELL_DB=./data/resell.db

# --- private beta (see deploy/beta.md) ---------------------------------------
# Only needed on the machine that serves the beta behind Cloudflare Access.

# Flask's session key. Only flash messages depend on it today, so the cost of
# leaving it unset is the odd lost message after a restart -- but a stable value
# costs nothing and removes an assumption that stops being harmless the moment
# anything of value goes in a session.
#   python -c "import secrets; print(secrets.token_hex(32))"
# RESELL_SECRET_KEY=

# Comma-separated. These addresses get /ops, see every item, and inherit any
# item that predates the beta. Everyone else gets their own consumer shelf.
# RESELL_ADMIN_EMAILS=you@example.com

# Local development only. Stands in for the Cloudflare Access header when there
# is no tunnel. NEVER set this on the beta host: with it set, anyone who reaches
# the port is that person.
# RESELL_DEV_EMAIL=you@example.com
