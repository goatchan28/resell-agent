# Copy to .env and fill in from https://developer.ebay.com/my/keys
# .env is gitignored. These are secrets.

# "sandbox" or "production". Everything below must match this environment:
# sandbox and production have separate keysets AND separate RuNames.
EBAY_ENV=sandbox

# From Application Keys page. Sandbox keyset, not production.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# The RuName (a.k.a. "eBay Redirect URL name"), NOT a URL.
# Looks like: Your_Name-YourNam-SomeAp-abcdefgh
# Found under Application Keys -> User Tokens -> "Get a Token from eBay via Your Application".
EBAY_RUNAME=

# Optional. Space-separated. Defaults to the V1 set in config.py.
# Scope strings always use the api.ebay.com host, even for sandbox.
# EBAY_SCOPES=

EBAY_MARKETPLACE_ID=EBAY_US

# SQLite file. Holds tokens and the append-only event log.
RESELL_DB=./data/resell.db
